# Fynvita - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# GOOGLE GEMINI / NANO BANANA (Optional — only for asset generation pipeline)
# =============================================================================
# Get from: https://aistudio.google.com/apikey
# Used by scripts/assets/generate.ts for brand-asset generation.
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# SUPABASE (Required for Database & Auth)
# =============================================================================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# STRIPE (Required for Payments)
# =============================================================================
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Product Price IDs - Create products in Stripe Dashboard first
# Products → Add Product → Copy Price ID
# New Pricing Model (2025): Free / Standard / Pro / Family Duo / Family / Family Plus
STRIPE_STANDARD_PRICE_ID=price_1234567890_standard
STRIPE_PRO_PRICE_ID=price_1234567890_pro
STRIPE_FAMILY_DUO_PRICE_ID=price_1234567890_family_duo
STRIPE_FAMILY_PRICE_ID=price_1234567890_family
STRIPE_FAMILY_PLUS_PRICE_ID=price_1234567890_family_plus

# Annual pricing (Standard 3%, Pro 8%, Family tiers 18%)
STRIPE_STANDARD_ANNUAL_PRICE_ID=price_1234567890_standard_annual
STRIPE_PRO_ANNUAL_PRICE_ID=price_1234567890_pro_annual
STRIPE_FAMILY_DUO_ANNUAL_PRICE_ID=price_1234567890_family_duo_annual
STRIPE_FAMILY_ANNUAL_PRICE_ID=price_1234567890_family_annual
STRIPE_FAMILY_PLUS_ANNUAL_PRICE_ID=price_1234567890_family_plus_annual

# Webhook Secret - From Stripe CLI or Dashboard
# stripe listen --forward-to localhost:3000/api/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# RESEND (Required for Email Notifications)
# =============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Fynvita <noreply@Fynvita-pro.com>

# =============================================================================
# AWS S3 (Required for Document Storage)
# =============================================================================
# Create IAM user with S3 access and get credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=Fynvita-pro-documents

# =============================================================================
# AIML API (Required for AI Features)
# =============================================================================
# Get from: https://aimlapi.com
AIML_API_KEY=your_aiml_api_key_here
AIML_API_URL=https://api.aimlapi.com/v1

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# Your app URL (local development or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL: Additional Services
# =============================================================================
# Add any additional environment variables below
