# CreditMaster Pro - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# SUPABASE (Required for Database & Auth)
# =============================================================================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# STRIPE (Required for Payments)
# =============================================================================
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Product Price IDs - Create products in Stripe Dashboard first
# Products → Add Product → Copy Price ID
NEXT_PUBLIC_STRIPE_BASIC_PRICE_ID=price_1234567890_basic
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_1234567890_premium
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_1234567890_enterprise

# Webhook Secret - From Stripe CLI or Dashboard
# stripe listen --forward-to localhost:3000/api/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# RESEND (Required for Email Notifications)
# =============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=CreditMaster Pro <noreply@creditmaster-pro.com>

# =============================================================================
# AWS S3 (Required for Document Storage)
# =============================================================================
# Create IAM user with S3 access and get credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=creditmaster-pro-documents

# =============================================================================
# AIML API (Required for AI Features)
# =============================================================================
# Get from: https://aimlapi.com
AIML_API_KEY=your_aiml_api_key_here
AIML_API_URL=https://api.aimlapi.com/v1

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# Your app URL (local development or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL: Additional Services
# =============================================================================
# Add any additional environment variables below
