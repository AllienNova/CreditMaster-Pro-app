# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.production.local and fill in values
# NEVER commit .env.production.local to version control!

# ============================================
# REQUIRED - Application Core
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://CPFI.pro
NEXT_PUBLIC_APP_NAME=CPFI

# ============================================
# REQUIRED - Database (Supabase)
# ============================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# REQUIRED - Authentication
# ============================================
# Generate secrets: openssl rand -base64 32
NEXTAUTH_URL=https://CPFI.pro
NEXTAUTH_SECRET=your-32-character-secret-here
JWT_SECRET=another-32-character-secret-here

# ============================================
# REQUIRED - Stripe Payments
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Product IDs (create in Stripe Dashboard)
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx

# ============================================
# REQUIRED - AI Services (AIML API)
# ============================================
# Get from: https://aimlapi.com/dashboard
AIML_API_KEY=your-aiml-api-key
AIML_API_URL=https://api.aimlapi.com/v1

# ============================================
# REQUIRED - Email Service (SendGrid)
# ============================================
# Get from: https://app.sendgrid.com/settings/api_keys
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@CPFI.pro
EMAIL_REPLY_TO=support@CPFI.pro

# ============================================
# OPTIONAL - Document Storage (Supabase Storage)
# ============================================
# Supabase Storage is used by default. Only set these for S3:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=CPFI-pro-documents

# ============================================
# REQUIRED - Monitoring & Analytics
# ============================================
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx

# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Logging
LOG_LEVEL=info

# ============================================
# REQUIRED - Security
# ============================================
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-64-character-hex-key

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS (comma-separated origins)
CORS_ORIGINS=https://CPFI.pro,https://app.CPFI.pro

# Cron job secret (for Vercel Cron)
# Generate: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ============================================
# OPTIONAL - Feature Flags
# ============================================
ENABLE_MARKETPLACE=true
ENABLE_STUDENT_LOANS=true
ENABLE_AI_CHAT=true
ENABLE_ADVANCED_STRATEGIES=true

# ============================================
# OPTIONAL - Redis Cache (Upstash)
# ============================================
# Get from: https://console.upstash.com/
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ============================================
# OPTIONAL - External APIs
# ============================================
# Credit Bureau APIs (for future integration)
# EXPERIAN_API_KEY=
# EQUIFAX_API_KEY=
# TRANSUNION_API_KEY=

# Identity Verification (for future KYC)
# PLAID_CLIENT_ID=
# PLAID_SECRET=

