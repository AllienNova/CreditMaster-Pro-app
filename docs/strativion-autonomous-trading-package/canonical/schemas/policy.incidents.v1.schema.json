              "type": "string"
            },
            "page_delay": {
              "type": "string"
            },
            "scope_action": {
              "type": "string"
            }
          }
        },
        "SEV3": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "label": {
              "type": "string"
            },
            "response": {
              "type": "string"
            },
            "page_delay": {},
            "scope_action": {
              "type": "string"
            }
          }
        },
        "SEV4": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "label": {
              "type": "string"
            },
            "response": {
              "type": "string"
            },
            "page_delay": {},
            "scope_action": {
              "type": "string"
            }
          }
        }
      }
    },
