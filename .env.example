# AIML API Configuration
# Get your API key from: https://aimlapi.com/
AIML_API_KEY=your_aiml_api_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1

# Model Configuration
# Primary chat model for general conversations
AIML_DEFAULT_CHAT_MODEL=anthropic/claude-4.5-sonnet

# Reasoning model for complex analysis
AIML_REASONING_MODEL=deepseek/deepseek-r1

# Fast model for quick responses
AIML_FAST_MODEL=openai/gpt-4o-mini

# Image generation model
AIML_IMAGE_MODEL=flux-pro

# Voice synthesis model
AIML_VOICE_MODEL=tts-1-hd

# Feature Flags
ENABLE_MULTI_MODEL=true
ENABLE_VOICE_ASSISTANT=true
ENABLE_IMAGE_GENERATION=true
ENABLE_SEMANTIC_SEARCH=true

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# TAX OPTIMIZATION MODULE - OCR PROVIDERS
# ============================================================================
# Multi-provider OCR for tax document processing with intelligent fallback

# OpenAI Vision (Primary Provider)
# Best for: Context understanding, complex document layouts
# Get API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Cloud Vision (Secondary Provider)
# Best for: Fast, accurate raw OCR extraction
# Get API key: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# LandingAI (Tertiary Provider - Optional)
# Best for: Specialized document understanding
# Get API key: https://landing.ai/
LANDING_AI_API_KEY=your_landing_ai_api_key_here

# OCR Provider Configuration (optional overrides)
# OCR_PRIMARY_PROVIDER=openai_vision
# OCR_FALLBACK_CONFIDENCE_THRESHOLD=0.85
# OCR_MAX_RETRIES=2

# ============================================================================
# WEB PUSH NOTIFICATIONS (VAPID Keys)
# ============================================================================
# Generate new VAPID keys with: npx web-push generate-vapid-keys
# These keys are used for Web Push notifications via the Push API

# Public VAPID key (shared with browser clients)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Private VAPID key (server-side only, keep secret!)
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Contact email for VAPID (required by push services)
VAPID_SUBJECT=mailto:support@fynvita.com

