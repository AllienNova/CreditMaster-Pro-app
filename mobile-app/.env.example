# Fynvita Mobile App Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Supabase Configuration (Required)
# ===========================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# API Configuration
# ===========================================
# For development:
#   - Android Emulator: http://10.0.2.2:3000/api (auto-detected if not set)
#   - iOS Simulator: http://localhost:3000/api (auto-detected if not set)
#   - Physical Device: http://YOUR_MACHINE_IP:3000/api
# For production:
#   - Your deployed API URL with /api suffix
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ===========================================
# App Configuration
# ===========================================
EXPO_PUBLIC_APP_NAME=Fynvita
EXPO_PUBLIC_APP_VERSION=1.0.0

# ===========================================
# Optional: EAS Build Configuration
# ===========================================
# EAS_PROJECT_ID=your-eas-project-id

